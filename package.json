{
  "name": "stabilimento",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts up",
    "db:rollback": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts down",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/db/seed.ts",
    "db:types": "kysely-codegen --dialect postgres --date-parser string --out-file src/db/types.ts",
    "test:e2e": "playwright test",
    "db:seed-admin": "node --env-file-if-exists=.env --import tsx src/db/seed-admin.ts"
  },
  "dependencies": {
    "better-auth": "1.7.20",
    "kysely": "0.29.8",
    "next": "16.4.6",
    "next-intl": "4.14.10",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "kysely-codegen": "0.20.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
