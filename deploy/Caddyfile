# Reverse proxy and HTTPS for the club box (ADR 0003, ADR 0008).
{
	# A device that connects by IP (https://192.168.0.50) sends no server name, and behind
	# Docker's port mapping Caddy can't pick a certificate by the address it dialed: without
	# this, those connections fail with a TLS "internal error". Set to the box's IP.
	default_sni {$DEFAULT_SNI:localhost}
}

# SITE_ADDRESS lists every name/IP staff use, e.g. "stabilimento.local, 192.168.1.10".
{$SITE_ADDRESS:localhost} {
	# Caddy's own CA: works offline; each staff device trusts its root once (RUNBOOK).
	tls internal
	# The live map's event stream (ADR 0019) must not wait in a compression buffer.
	@compressible not path /api/live
	encode @compressible zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Baseline only: Next's inline scripts would need nonces before scripts can be limited.
		Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
	reverse_proxy app:3000 {
		# The only client-IP header the app trusts. Overwrites anything the client sent.
		header_up X-Real-IP {remote_host}
	}
	# Searches carry customer names and phones in `?q=`: keep them out of the access log.
	log {
		format filter {
			wrap json
			fields {
				request>uri query {
					delete q
				}
			}
		}
	}
}
