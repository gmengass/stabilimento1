# Nightly backup (ADR 0022). Installed by scripts/install-backup-timer.sh, which fills in
# @USER@ and @ROOT@. A run the timeout kills still sends the failure alert (TERM trap).
[Unit]
Description=Stabilimento nightly backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@ROOT@
Environment=DEPLOY_ROOT=@ROOT@
ExecStart=/bin/sh @ROOT@/scripts/backup.sh
TimeoutStartSec=3h
Nice=10
IOSchedulingClass=idle
