# Copy to .env and fill in. Never commit .env.

# App (npm run dev / db:migrate)
DATABASE_URL=postgresql://booking:booking@localhost:5432/booking
APP_URL=http://localhost:3000
# Signs session cookies. At least 32 characters: `openssl rand -hex 32`
AUTH_SECRET=

# First admin account, created by `npm run db:seed-admin` (no-op if it exists).
# Pick a username other than "admin". Password: at least 10 characters.
# Remove ADMIN_PASSWORD from .env after the first login.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Integration tests only. The database name must end in _test.
# `docker compose -f docker-compose.test.yml up -d` provides one on port 5433.
TEST_DATABASE_URL=postgresql://booking:booking@localhost:5433/booking_test

# Docker Compose stack (docker-compose.yml, ADR 0008)
# On the club box: APP_URL=https://stabilimento.local
# Every name/IP staff type in the browser; Caddy issues a certificate for each.
SITE_ADDRESS=localhost
# The certificate Caddy sends when a device connects by IP (no server name): the box's IP from
# SITE_ADDRESS, e.g. 192.168.1.10. Needed for https://<IP> and the Android app's IP fallback.
DEFAULT_SNI=localhost
# Other https origins staff use besides APP_URL, comma-separated, e.g. https://192.168.1.10
# https://localhost lets the local full stack (Caddy) sign in while APP_URL points at npm run dev.
TRUSTED_ORIGINS=https://localhost
# Android app only (scripts/build-android.sh, ADR 0011): the box's Tailscale address, opened when
# APP_URL doesn't answer. An https origin that is also in TRUSTED_ORIGINS and SITE_ADDRESS, e.g.
# https://stabilimento.<tailnet>.ts.net. Leave empty without Tailscale.
REMOTE_URL=
POSTGRES_USER=booking
# Use letters and digits only: it is inserted into a URL. e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=change-me
POSTGRES_DB=booking

# Backups (ADR 0022, docs/RUNBOOK.md "Backups"). BACKUP_DIR: dumps on the box's own disk
# (default ./backups): pre-update/ plaintext, nightly/ encrypted.
BACKUP_DIR=
# Public key(s) the nightly backups are encrypted to (age1..., space-separated). The secret key
# (AGE-SECRET-KEY-1...) goes in the password manager, never on the box.
BACKUP_AGE_RECIPIENTS=
# rclone remote and folder for the OneDrive copy, e.g. onedrive:stabilimento-backups.
# Empty = box disk only (a warning every night).
BACKUP_RCLONE_REMOTE=
# Failure alert email. e.g. smtp://smtp.office365.com:587 (STARTTLS) or smtps://...:465
BACKUP_ALERT_SMTP_URL=
# user:password for the SMTP server (never shown on the command line)
BACKUP_ALERT_SMTP_USER=
BACKUP_ALERT_FROM=
# Space-separated addresses
BACKUP_ALERT_TO=
# Optional: a monitor URL called after every good backup (e.g. healthchecks.io), so you hear
# when backups stop altogether.
BACKUP_HEARTBEAT_URL=
