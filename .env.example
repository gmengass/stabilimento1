# Copy to .env and fill in. Never commit .env.

# App (npm run dev / db:migrate)
DATABASE_URL=postgresql://booking:booking@localhost:5432/booking
APP_URL=http://localhost:3000
# Signs session cookies. At least 32 characters: `openssl rand -hex 32`
AUTH_SECRET=

# First admin account, created by `npm run db:seed-admin` (no-op if it exists).
# Pick a username other than "admin". Password: at least 10 characters.
# Remove ADMIN_PASSWORD from .env after the first login.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Integration tests only. The database name must end in _test.
# `docker compose -f docker-compose.test.yml up -d` provides one on port 5433.
TEST_DATABASE_URL=postgresql://booking:booking@localhost:5433/booking_test

# Docker Compose stack (docker-compose.yml, ADR 0008)
# On the club box: APP_URL=https://stabilimento.local
# Every name/IP staff type in the browser; Caddy issues a certificate for each.
SITE_ADDRESS=localhost
# Other https origins staff use besides APP_URL, comma-separated, e.g. https://192.168.1.10
# https://localhost lets the local full stack (Caddy) sign in while APP_URL points at npm run dev.
TRUSTED_ORIGINS=https://localhost
POSTGRES_USER=booking
# Use letters and digits only: it is inserted into a URL. e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=change-me
POSTGRES_DB=booking

# Added by later roadmap items
# SMTP_URL=
